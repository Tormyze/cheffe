# Porta em que o servidor Express irá rodar
PORT=3001

# Gere um valor aleatório forte para uso local/produção
JWT_SECRET="replace-with-a-long-random-secret"

# String de Conexão com o PostgreSQL do Supabase (Direct Connection / Session Pooler)
# Exemplo de formato: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL="postgresql://postgres.User:Password@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Conexão direta do Prisma com PostgreSQL do Supabase
DIRECT_URL="******db.PROJECT_REF.supabase.co:5432/postgres"